# Copie para .env. Nunca coloque senhas reais no repositório (P6).
NODE_ENV=development
PORTA=3000
# Endereço público da aplicação (links dos e-mails).
URL_APLICACAO=http://localhost:5173
# Conexão da API: papel sem privilégio de ignorar o RLS.
DATABASE_URL=postgres://vinicycle_app:app_local@localhost:5432/vinicycle
# Conexão do dono do esquema: migrações e dados de referência.
DATABASE_URL_DONO=postgres://vinicycle_dono:dono_local@localhost:5432/vinicycle
# Bancos de teste (Vitest).
DATABASE_URL_TESTE=postgres://vinicycle_app:app_local@localhost:5432/vinicycle_teste
DATABASE_URL_DONO_TESTE=postgres://vinicycle_dono:dono_local@localhost:5432/vinicycle_teste
# Chave de 32 bytes em base64 para cifrar segredos (segundo fator). Gere com: openssl rand -base64 32
CHAVE_CIFRA=
# Pasta dos anexos (armazenamento em disco, compatível com a troca futura por S3).
ARMAZENAMENTO_DIR=../../armazenamento
# E-mail: "console" (desenvolvimento: grava no log) ou "resend".
EMAIL_PROVEDOR=console
EMAIL_REMETENTE="ViniCycle <nao-responda@vinicycle.com>"
RESEND_API_KEY=
