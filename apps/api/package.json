{
  "name": "@vinicycle/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:gerar": "drizzle-kit generate",
    "db:migrar": "tsx --env-file-if-exists=.env src/bin/migrar.ts",
    "db:referencia": "tsx --env-file-if-exists=.env src/bin/referencia.ts",
    "cli": "tsx --env-file-if-exists=.env src/bin/cli.ts",
    "demo": "tsx --env-file-if-exists=.env src/bin/demo.ts"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/yazl": "^3.3.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@node-rs/argon2": "^2.2.1",
    "@vinicycle/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "uuid": "^14.0.2",
    "yazl": "^3.3.1",
    "zod": "^4.6.5"
  }
}
